<Page x:Class="WpfNavigationLab.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Névjegy"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Saját ötlet: alkalmazáson belüli információs képernyő."
                       FontSize="16"
                       Foreground="#64748B"
                       Margin="0,10,0,25"/>

            <Border Background="White"
                    CornerRadius="15"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="WPF Navigation Lab"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Ez az oldal egy Page, ezért a már megnyitott MainWindow Frame-jében jelenik meg, és nem nyit új ablakot."
                               TextWrapping="Wrap"
                               Margin="0,10,0,20"/>

                    <TextBlock Text="Készült a WPF többablakos alkalmazások és Page navigáció tananyag gyakorlásához."
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <Button Content="Vissza"
                            Height="45"
                            Click="Back_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Page>
